@using PostgreMVCApp.DTO
@model PagedResult<Status>;
@{
    ViewData["Title"] = "Master Status";
    Layout = "~/Views/Shared/TestLayout.cshtml";
}

<div class="col-12 col-xl-10 mx-auto" style="padding: 20px;">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-title fw-bold mb-0">
                        <i class="fa-solid fa-circle-notch"></i> Master Status
                    </div>
                    <div class="text-muted small">Manage request statuses</div>
                </div>
                <div class="d-flex gap-2">
                    <form asp-action="Status" method="get" class="d-flex">
                        <input type="text" name="search" class="form-control" value="@Model?.SearchTerm" id="searchInput" placeholder="Search status..." style="width: 250px;margin-right:10px;">
                        <button type="submit" class="btn btn-secondary">Search</button>
                    </form>

                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStatusModal">
                        <i class="fa-solid fa-plus"></i> Add New
                    </button>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th style="width: 150px;">Action</th>
                    </tr>
                </thead>
                <tbody id="statusTableBody">
                    @if (Model != null && Model.Items.Any())
                    {
                        @foreach (var status in Model.Items)
                        {
                            <tr>
                                <td>@status.Name</td>
                                <td>
                                    <button class="btn btn-sm btn-warning" title="Edit" data-bs-toggle="modal" data-bs-target="#editStatusModal" onclick="editStatus(@status.Id)">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" title="Delete" onclick="deleteStatus(@status.Id)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">
                                No status found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <nav aria-label="Page navigation" style="padding-top:10px;">
        <ul class="pagination">
            @if (Model != null)
            {
                int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);

                <!-- Previous -->
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Status"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-search="@Model.SearchTerm">
                        Previous
                    </a>

                </li>

                <!-- Page numbers -->
                for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-action="Status"
                           asp-route-page="@i"
                           asp-route-search="@Model.SearchTerm">
                            @i
                        </a>
                    </li>
                }

                <!-- Next -->
                <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Status"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-search="@Model.SearchTerm">
                        Next
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>

<!-- Add Status Modal -->
<div class="modal fade" id="addStatusModal" tabindex="-1" aria-labelledby="addStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addStatusModalLabel">Add New Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addStatusForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="statusName" class="form-label">Status Name</label>
                        <input type="text" class="form-control" id="statusName" name="statusName" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Status Modal -->
<div class="modal fade" id="editStatusModal" tabindex="-1" aria-labelledby="editStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editStatusModalLabel">Edit Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editStatusForm">
                <div class="modal-body">
                    <input type="hidden" id="editStatusId" name="editStatusId">
                    <div class="mb-3">
                        <label for="editStatusName" class="form-label">Status Name</label>
                        <input type="text" class="form-control" id="editStatusName" name="editStatusName" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
        // Get CSRF token
        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        };

        // Add Status Form Submit
        document.getElementById('addStatusForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const statusName = document.getElementById('statusName').value;
            console.log("status name: ", statusName);
            const token = getAntiForgeryToken();

            fetch('@Url.Action("AddStatus", "Master")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({
                    'statusName': statusName,
                    '__RequestVerificationToken': token
                })
            })
            .then(response => {
                if (response.ok) {
                    // Show success message
                    alert('Status added successfully!');

                    // Reset form and close modal
                    this.reset();
                    bootstrap.Modal.getInstance(document.getElementById('addStatusModal')).hide();

                    // Reload the page to see the new status
                    location.reload();
                } else {
                    alert('Error adding status');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while adding status');
            });
        });

        // Edit Status Form Submit
        document.getElementById('editStatusForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const statusId = document.getElementById('editStatusId').value;
            const statusName = document.getElementById('editStatusName').value;
            const token = getAntiForgeryToken();

            // TODO: Create an UpdateStatus action method similar to AddStatus
            fetch('@Url.Action("UpdateStatus", "Master")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({
                    'id': statusId,
                    'statusName': statusName,
                    '__RequestVerificationToken': token
                })
            })
            .then(response => {
                if (response.ok) {
                    alert('Status updated successfully!');
                    this.reset();
                    bootstrap.Modal.getInstance(document.getElementById('editStatusModal')).hide();
                    location.reload();
                } else {
                    alert('Error updating status');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while updating status');
            });
        });

        // Edit Status Function
        function editStatus(id) {
            const token = getAntiForgeryToken();

            // Fetch the status data from your API
            fetch('@Url.Action("GetStatus", "Master")/' + id, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            })
            .then(response => {
                if (response.ok) {
                    return response.json();
                } else {
                    throw new Error('Failed to fetch status');
                }
            })
            .then(data => {
                // Populate the modal with the fetched data
                document.getElementById('editStatusId').value = data.id;
                document.getElementById('editStatusName').value = data.name;

                // Show the modal
                const editModal = new bootstrap.Modal(document.getElementById('editStatusModal'));
                editModal.show();
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while loading status');
            });
        }

        // Delete Status Function
        function deleteStatus(id) {
            if (confirm('Are you sure you want to delete this status?')) {
                const token = getAntiForgeryToken();

                fetch('@Url.Action("DeleteStatus", "YourControllerName")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: new URLSearchParams({
                        'id': id,
                        '__RequestVerificationToken': token
                    })
                })
                .then(response => {
                    if (response.ok) {
                        alert('Status deleted successfully!');
                        location.reload();
                    } else {
                        alert('Error deleting status');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while deleting status');
                });
            }
        }
</script>