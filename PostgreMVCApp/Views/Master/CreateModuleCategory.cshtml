@model PostgreMVCApp.Models.ModuleCategory
<h2>Add New Module Category</h2>
@if (TempData["Error"] != null)
{
    <script>
        alert('@TempData["Error"]');
    </script>
}
<form action="CreateModuleCategory" method="post" class="row g-3">
    <div class="col-md-3">
        <label for="inputEmail4" class="form-label">Name</label>
        <input asp-for="Name" type="text" class="form-control" id="inputEmail4" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">Link</label>
        <input asp-for="Link" type="text" class="form-control" required />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="ModuleCategory" asp-controller="Master">
            <input type="button" class="btn btn-danger" value="Back To List" />
        </a>
    </div>

</form>