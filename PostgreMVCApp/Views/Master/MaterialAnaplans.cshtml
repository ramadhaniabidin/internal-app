@using PostgreMVCApp.DTO
@using PostgreMVCApp.DTO.Display
@model PagedResult<MaterialAnaplanDisplay>;
@{
    Layout = "~/Views/Shared/TestLayout.cshtml";
    ViewData["Title"] = "Master Material Anaplan";
}

@if (TempData["Error"] != null)
{
    <script>
        alert('@TempData["Error"]');
    </script>
}

<div class="col-12 col-xl-12 mx-auto" style="padding: 20px;">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-title fw-bold mb-0">
                        <i class="fa-solid fa-circle-notch"></i> Master Material Anpalans
                    </div>
                    <div class="text-muted small">Manage Material Anaplans</div>
                </div>
                <div class="d-flex gap-2">
                    <form asp-action="MaterialAnaplans" method="get" class="d-flex">
                        <input type="text" name="search" class="form-control" value="@Model?.SearchTerm"
                               id="searchInput" placeholder="Search material anaplans..."
                               style="width: 250px;margin-right:10px;">
                        <button type="submit" class="btn btn-secondary">Search</button>
                    </form>
                    <form asp-action="CreateMaterialAnaplan" asp-controller="Master">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-plus"></i> Add New
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Procurement Department</th>
                        <th>General Ledgers</th>
                        <th style="width: 150px;">Action</th>
                    </tr>
                </thead>
                <tbody id="statusTableBody">
                    @if (Model != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.Description</td>
                                <td>@item.ProcDeptCode - @item.ProcDeptName</td>
                                <td>@item.GeneralLedgerCode - @item.GeneralLedgerDescription</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <form asp-action="EditMaterialAnaplan" asp-controller="Master" asp-route-id="@item.Id">
                                            <button type="submit" class="btn btn-sm btn-warning" title="Edit">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                        </form>
                                        <form asp-action="EditMaterialAnaplan" asp-controller="Master">
                                            <button type="button" class="btn btn-sm btn-danger" title="Delete"
                                                    onclick="deleteGL(@item.Id)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">
                                No General Ledgers found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <nav aria-label="Page navigation" style="padding-top:10px;">
        <ul class="pagination">
            @if (Model != null)
            {
                int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);

                <!-- Previous -->
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="MaterialAnaplans" asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-search="@Model.SearchTerm">
                        Previous
                    </a>

                </li>

                <!-- Page numbers -->
                for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="MaterialAnaplans" asp-route-page="@i"
                           asp-route-search="@Model.SearchTerm">
                            @i
                        </a>
                    </li>
                }

                <!-- Next -->
                <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="MaterialAnaplans" asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-search="@Model.SearchTerm">
                        Next
                    </a>
                </li>
            }
        </ul>
    </nav>

    <a asp-action="Index" asp-controller="Home">
        <input type="button" class="btn btn-primary" value="Back To Home" />
    </a>

    <partial name="_ModalPartial" />

</div>

<script src="~/js/Master/material-anaplans.js"></script>