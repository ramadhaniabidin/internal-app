@using PostgreMVCApp.DTO
@using PostgreMVCApp.DTO.Display
@model PagedResult<UserProcDept>;
@{
    Layout = "~/Views/Shared/TestLayout.cshtml";
    ViewData["Title"] = "Master User Procurement Department";
}

@if (TempData["Error"] != null)
{
    <script>
        alert('@TempData["Error"]');
    </script>
}

<div class="col-12 col-xl-12 mx-auto" style="padding: 20px;">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-title fw-bold mb-0">
                        <i class="fa-solid fa-circle-notch"></i> Master User Procurement Departments
                    </div>
                    <div class="text-muted small">Manage user Procurement Departments</div>
                </div>
                <div class="d-flex gap-2">
                    <form asp-action="UserProcDepts" method="get" class="d-flex">
                        <input type="text" name="search" class="form-control" value="@Model?.SearchTerm"
                               id="searchInput" placeholder="Search user..."
                               style="width: 250px;margin-right:10px;">
                        <button type="submit" class="btn btn-secondary">Search</button>
                    </form>
                    <button class="btn btn-primary" onclick="createNew()">
                        <i class="fa-solid fa-plus"></i> Add New
                    </button>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User Account</th>
                        <th>User Id</th>
                        <th>User Name</th>
                        <th>User Email</th>
                        <th>Proc Dept Id</th>
                        <th>Proc Dept Code</th>
                        <th>Proc Dept Name</th>
                        <th>Branch Code</th>
                        <th>Branch Name</th>
                        <th style="width: 150px;">Action</th>
                    </tr>
                </thead>
                <tbody id="statusTableBody">
                    @if (Model != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.UserAccount</td>
                                <td>@item.UserId</td>
                                <td>@item.UserFullName</td>
                                <td>@item.UserEmail</td>
                                <td>@item.ProcurementDepartmentId</td>
                                <td>@item.ProcDeptCode</td>
                                <td>@item.ProcDeptName</td>
                                <td>@item.BranchCode</td>
                                <td>@item.BranchName</td>
                                <td>
                                    <button class="btn btn-sm btn-warning" title="Edit"
                                            onclick="editContractType(@item.Id)">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" title="Delete"
                                            onclick="deleteContractType(@item.Id)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">
                                No User Procurement Departments found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <nav aria-label="Page navigation" style="padding-top:10px;">
        <ul class="pagination">
            @if (Model != null)
            {
                int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);

                <!-- Previous -->
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="ContractTypes" asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-search="@Model.SearchTerm">
                        Previous
                    </a>

                </li>

                <!-- Page numbers -->
                for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="ContractTypes" asp-route-page="@i"
                           asp-route-search="@Model.SearchTerm">
                            @i
                        </a>
                    </li>
                }

                <!-- Next -->
                <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="ContractTypes" asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-search="@Model.SearchTerm">
                        Next
                    </a>
                </li>
            }
        </ul>
    </nav>

    <a asp-action="Index" asp-controller="Home">
        <input type="button" class="btn btn-primary" value="Back To Home" />
    </a>

    <partial name="_ModalPartial" />

</div>

<script src="~/js/Master/user-proc-dept.js"></script>