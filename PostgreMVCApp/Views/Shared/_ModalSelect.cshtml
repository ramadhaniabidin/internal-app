<div class="modal" id="modal-select">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-label"></h5>
                <button type="button" class="btn-close" onclick="closeModal()"></button>
            </div>
            <div id='modal-body' class="modal-body">
            </div>
            <div id="modal-footer" class="modal-footer d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-secondary" onclick="popUpPrev()">Previous</button>
                <span id="footer-text" class="text-muted"></span>
                <button type="button" class="btn btn-primary" onclick="popUpNext()">Next</button>
            </div>
        </div>
    </div>
</div>