@model PostgreMVCApp.DTO.Display.HomeDisplay

<aside id="sidebar" class="sidebar border-end" aria-label="Sidebar" aria-expanded="true">
    <div class="sidebar-body d-flex flex-column gap-3 flex-grow-1">
        <!-- Brand -->
        <a href="/Home" class="subitem d-grid gap-2 align-items-center px-2 py-2 rounded-3 text-decoration-none">
            <div style="margin-right: unset; margin-left: unset;"
                 class="brand bg-white border rounded-3 d-flex align-items-center px-3 py-2">
                <img src="~/images/DAIKIN_logo.svg_-768x166.png" alt="Brand" class="brand-logo"
                     style="width:200px; height:auto; padding-right: 10px" />
            </div>
        </a>

        <partial name="HomeNavbarItems" model="Model" />
    </div>

    <!-- USER CARD at the very bottom -->
    <div class="user-card border rounded-3 shadow-sm bg-white bg-opacity-75 p-3 mt-2">
        <div class="user-main d-grid" style="grid-template-columns: 44px 1fr; gap: 12px;">
            <div class="avatar-wrap position-relative" style="width:44px;height:44px;">
                <img id="userAvatar" class="avatar rounded-circle border" src="~/images/avatar.webp" alt="User avatar"
                     style="width:44px;height:44px;object-fit:cover;">
                <span
                class="presence position-absolute translate-middle p-1 bg-success border border-white rounded-circle"
                title="Online" style="bottom:-2px; right:-2px; width:10px; height:10px;"></span>
            </div>

            <div class="meta d-flex flex-column">
                <strong id="userName" class="name fw-bold lh-sm">User Name</strong>
                <div id="userSub" class="sub text-muted small">Role or email</div>
            </div>

            <!-- ACTIONS: side by side under the name -->
            <div class="user-actions d-flex gap-2 align-items-center mt-2">
                <button id="btnProfile" class="btn btn-light btn-sm d-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-id-badge"></i><span class="act-label">Profile</span>
                </button>
                <form asp-action="Logout" asp-controller="Account">
                    <button type="submit" id="btnLogout" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-2">
                        <i class="fa-solid fa-right-from-bracket"></i><span class="act-label">Logout</span>
                    </button>
                </form>

            </div>
        </div>
    </div>
</aside>