@{
    Layout = null;
}
@model PostgreMVCApp.DTO.Display.HomeDisplay;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/style.css" />

</head>


<body>
    <div class="container">
        <aside class="sidebar">
            <div class="logo">
                <img src="~/images/DAIKIN_logo.svg_-768x166.png" alt="Daikin Logo" class="daikin-logo">
            </div>

            <nav class="menu">
                <ul>
                    <li class="active"><a href="/Home/Index"><i class="fas fa-home"></i><span>Home</span></a></li>
                    @if (Model != null && Model.ModuleCategories.Any())
                    {
                        foreach (var category in Model.ModuleCategories)
                        {
                            if(category.Modules != null && category.Modules.Any())
                            {
                                <li class="navbar-dropdown">
                                    <a href="@category.Link">
                                        <i class="@category.IconClass"></i>
                                        <span>@category.Name</span>
                                    </a>

                                    <ul class="navbar-dropdown-content">
                                        @foreach(var module in category.Modules)
                                        {
                                            <li>
                                                <a href="@module.Link">
                                                    <i class="@module.IconClass"></i>
                                                    <span>@module.Name</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>

                            }
                            else
                            {
                                <li>
                                    <a href="@category.Link">
                                        <i class="@category.IconClass"></i>
                                        <span>@category.Name</span>
                                    </a>
                                </li>
                            }
    
                        }
                    }
                    @if (User != null && User.IsInRole("Admin"))
                    {
                        <li class="navbar-dropdown">
                            <a href="/Master/">
                                <i class="fa-solid fa-folder-tree"></i>
                                <span>Master Data</span>
                            </a>
                            <ul class="navbar-dropdown-content">
                                <li><a href="/Master/Branch"><i class="fa-solid fa-building"></i><span>Branch</span></a></li>
                                <li><a href="/Master/ModuleCategory"><i class="fa-solid fa-table"></i><span>Module Category</span></a></li>
                                <li><a href="/Master/Module"><i class="fa-solid fa-cubes"></i><span>Module</span></a></li>
                                <li>
                                    <a href="/Master/ProcDept">
                                        <i class="fa-solid fa-cart-flatbed"></i>
                                        <span>Procurement Department</span>
                                    </a>
                                </li>
                                <li><a href="/Account/Users"><i class="fa-solid fa-users"></i><span>Users</span></a></li>
                                <li>
                                    <a href="/Account/Users">
                                        <i class="fa-solid fa-tags fa-fw"></i>
                                        <span>Master Status</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/Account/Users">
                                        <i class="fa-solid fa-tags fa-fw"></i>
                                        <span>Master Status</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/Account/Users">
                                        <i class="fa-solid fa-tags fa-fw"></i>
                                        <span>Master Status</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/Account/Users">
                                        <i class="fa-solid fa-tags fa-fw"></i>
                                        <span>Master Status</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </nav>

