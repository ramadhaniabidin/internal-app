@{
    Layout = "/Views/Shared/TestLayout.cshtml";
}

<!-- Topbar -->
<header style="display: none !important;" class="topbar sticky-top d-flex align-items-center gap-2 px-3 py-2 bg-light border-bottom">
    <div class="search d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white"
         style="min-width:280px;">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input id="search" type="search" class="form-control form-control-sm border-0 shadow-none"
               placeholder="Search people, tickets, docs…" aria-label="Search">
        <span class="kbd small text-muted border rounded-2 px-1">/</span>
    </div>

    <div class="spacer flex-grow-1"></div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <button class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2"
                title="Create ticket">
            <i class="fa-solid fa-circle-plus"></i> New Ticket
        </button>
        <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2"
                title="Submit request">
            <i class="fa-solid fa-file-circle-plus"></i> New Request
        </button>
        <button class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-2"
                title="Post announcement">
            <i class="fa-solid fa-bullhorn"></i> Announcement
        </button>
    </div>
</header>

